/* ============================================================
   Orman Tema
   ============================================================ */

QMainWindow, QWidget, QDialog {
    background-color: #F3F7F1;
    color: #1F2A23;
    font-family: "Segoe UI", "Inter", "Arial";
    font-size: 13px;
}

#HeaderBar {
    background-color: #1F6F4A;
    color: #FFFFFF;
    padding: 8px 16px;
    border-bottom: 1px solid #18583B;
}
#HeaderTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
    border: none;
}
#HeaderInfo {
    color: #EAF5EC;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QTabWidget::pane {
    border: none;
    background: #F3F7F1;
}
QTabBar::tab {
    background: #DDE8DA;
    color: #314238;
    padding: 8px 14px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    font-weight: 500;
    font-size: 12px;
    min-width: 60px;
}
QTabBar::tab:selected {
    background: #1F6F4A;
    color: #FFFFFF;
}
QTabBar::tab:hover:!selected {
    background: #C6D8C1;
}

QPushButton {
    background-color: #1F6F4A;
    color: #FFFFFF;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
}
QPushButton:hover { background-color: #18583B; }
QPushButton:pressed { background-color: #123F2C; }
QPushButton:disabled { background-color: #B8C8B6; color: #6E7B70; }

QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #1F6F4A;
    border: 1px solid #1F6F4A;
}
QPushButton#SecondaryButton:hover { background-color: #E5F0E3; }
QPushButton#DangerButton { background-color: #B8423B; }
QPushButton#DangerButton:hover { background-color: #92312E; }
QPushButton#SuccessButton { background-color: #2D7D46; }
QPushButton#SuccessButton:hover { background-color: #216238; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #1F2A23;
    border: 1px solid #9CB49C;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #1F6F4A;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #1F6F4A;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2A23;
    border: 1px solid #9CB49C;
    selection-background-color: #DDE8DA;
}

QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F3F7F1;
    color: #1F2A23;
    border: 1px solid #CFDDCB;
    border-radius: 6px;
    gridline-color: #E3ECE0;
    selection-background-color: #CFE3D0;
    selection-color: #123F2C;
}
QTableWidget::item, QTableView::item {
    padding: 4px 6px;
    border: none;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #CFE3D0;
    color: #123F2C;
    font-weight: 500;
}
QHeaderView::section {
    background-color: #DDE8DA;
    color: #314238;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #C6D8C1;
    border-right: 1px solid #CFDDCB;
    font-weight: 600;
    font-size: 11px;
}
QHeaderView { background-color: #DDE8DA; }

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #CFDDCB;
    border-radius: 6px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    color: #314238;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #1F6F4A;
    background-color: transparent;
}

QFrame#OrderCard {
    background-color: #FFFFFF;
    border: 1px solid #CFDDCB;
    border-radius: 8px;
    padding: 8px;
}
QFrame#OrderCard:hover {
    border: 1px solid #1F6F4A;
    background-color: #F6FAF4;
}
QLabel#OrderNumber { color: #1F6F4A; font-size: 14px; font-weight: bold; }
QLabel#OrderAmount { color: #216238; font-size: 13px; font-weight: bold; }
QLabel#OrderTime { color: #6E7B70; font-size: 11px; }
QLabel#OrderCustomer { color: #1F2A23; font-size: 13px; }

QFrame#KanbanColumn {
    background-color: #DDE8DA;
    border-radius: 8px;
    padding: 8px;
}
QLabel#KanbanTitle {
    color: #314238;
    font-size: 14px;
    font-weight: bold;
    padding: 4px 0;
}

QWidget#IncomingCallPopup {
    background-color: #FFFFFF;
    border: 2px solid #1F6F4A;
    border-radius: 12px;
}
QLabel#CallTitle { font-size: 14px; font-weight: bold; color: #1F6F4A; }
QLabel#CallNumber { font-size: 22px; font-weight: bold; color: #1F2A23; }
QLabel#CallMatchYes { font-size: 14px; color: #216238; font-weight: bold; }
QLabel#CallMatchNo { font-size: 14px; color: #B8423B; font-weight: bold; }

QLabel.StatusPill {
    border-radius: 10px;
    padding: 2px 8px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: bold;
}
QLabel#SummaryBox, QLabel#OrderNotes {
    background-color: #FFFFFF;
    color: #1F2A23;
    border: 1px solid #9CB49C;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: bold;
}
QLabel#SettingsInfo {
    color: #314238;
    font-size: 13px;
}

QCheckBox, QRadioButton {
    color: #1F2A23;
    spacing: 6px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #6E7B70;
    border-radius: 3px;
    background: #FFFFFF;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #1F6F4A;
}
QCheckBox::indicator:checked {
    background-color: #1F6F4A;
    border-color: #1F6F4A;
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #9CB49C;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #1F6F4A;
}
