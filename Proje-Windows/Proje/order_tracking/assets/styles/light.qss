/* ============================================================
   Açık Tema (Light)
   ============================================================ */

QMainWindow, QWidget {
    background-color: #F5F7FA;
    color: #212121;
    font-family: "Segoe UI", "Inter", "Arial";
    font-size: 13px;
}

/* Header bar */
#HeaderBar {
    background-color: #1976D2;
    color: white;
    padding: 8px 16px;
    border: none;
}
#HeaderTitle {
    color: white;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
    border: none;
}
#HeaderInfo {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
    border: none;
}

/* Tab widget */
QTabWidget::pane {
    border: none;
    background: #F5F7FA;
}
QTabBar::tab {
    background: #E0E0E0;
    color: #424242;
    padding: 8px 14px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    font-weight: 500;
    font-size: 12px;
    min-width: 60px;
}
QTabBar::tab:selected {
    background: #1976D2;
    color: white;
}
QTabBar::tab:hover:!selected {
    background: #BDBDBD;
}

/* Buttons */
QPushButton {
    background-color: #1976D2;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 500;
}
QPushButton:hover { background-color: #1565C0; }
QPushButton:pressed { background-color: #0D47A1; }
QPushButton:disabled { background-color: #BDBDBD; color: #757575; }

QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #1976D2;
    border: 1px solid #1976D2;
}
QPushButton#SecondaryButton:hover { background-color: #E3F2FD; }

QPushButton#DangerButton { background-color: #D32F2F; }
QPushButton#DangerButton:hover { background-color: #B71C1C; }

QPushButton#SuccessButton { background-color: #388E3C; }
QPushButton#SuccessButton:hover { background-color: #2E7D32; }

/* Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QTextEdit {
    background-color: white;
    border: 1px solid #BDBDBD;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #1976D2;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QTextEdit:focus {
    border: 1.5px solid #1976D2;
}

/* Tables */
QTableWidget, QTableView {
    background-color: white;
    alternate-background-color: #F5F7FA;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    gridline-color: #EEEEEE;
    selection-background-color: #BBDEFB;
    selection-color: #0D47A1;
}
QTableWidget::item, QTableView::item {
    padding: 4px 6px;
    border: none;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #BBDEFB;
    color: #0D47A1;
    font-weight: 500;
}
QHeaderView::section {
    background-color: #ECEFF1;
    color: #37474F;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #CFD8DC;
    border-right: 1px solid #E0E0E0;
    font-weight: 600;
    font-size: 11px;
}
QHeaderView { background-color: #ECEFF1; }

/* Order cards */
QFrame#OrderCard {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 8px;
}
QFrame#OrderCard:hover {
    border: 1px solid #1976D2;
    background-color: #F5FAFF;
}
QLabel#OrderNumber  { color: #1976D2; font-size: 14px; font-weight: bold; }
QLabel#OrderAmount  { color: #2E7D32; font-size: 13px; font-weight: bold; }
QLabel#OrderTime    { color: #757575; font-size: 11px; }
QLabel#OrderCustomer{ color: #212121; font-size: 13px; }

/* Kanban columns */
QFrame#KanbanColumn {
    background-color: #ECEFF1;
    border-radius: 8px;
    padding: 8px;
}
QLabel#KanbanTitle {
    color: #37474F;
    font-size: 14px;
    font-weight: bold;
    padding: 4px 0;
}

/* Incoming call popup */
QWidget#IncomingCallPopup {
    background-color: white;
    border: 2px solid #1976D2;
    border-radius: 12px;
}
QLabel#CallTitle      { font-size: 14px; font-weight: bold; color: #1976D2; }
QLabel#CallNumber     { font-size: 22px; font-weight: bold; color: #212121; }
QLabel#CallMatchYes   { font-size: 14px; color: #2E7D32; font-weight: bold; }
QLabel#CallMatchNo    { font-size: 14px; color: #C62828; font-weight: bold; }

/* Status pills */
QLabel.StatusPill {
    border-radius: 10px;
    padding: 2px 8px;
    color: white;
    font-size: 11px;
    font-weight: bold;
}

QLabel#SummaryBox {
    background-color: #FFFFFF;
    color: #212121;
    border: 1px solid #BDBDBD;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: bold;
}

QLabel#SettingsInfo {
    color: #424242;
    font-size: 13px;
}

QLabel#OrderNotes {
    color: #212121;
    font-size: 14px;
    font-weight: 500;
    padding: 6px 8px;
    background-color: #FFFFFF;
    border: 1px solid #BDBDBD;
    border-radius: 4px;
}

/* ---- Checkbox & Radio ---- */
QCheckBox, QRadioButton {
    color: #212121;
    spacing: 6px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 2px solid #757575;
    border-radius: 3px;
    background: #FFFFFF;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #1976D2;
}
QCheckBox::indicator:checked {
    background-color: #1976D2;
    border-color: #1976D2;
    image: none;
}
QRadioButton::indicator { border-radius: 8px; }
QRadioButton::indicator:checked {
    background-color: #1976D2;
    border-color: #1976D2;
}

/* ---- GroupBox ---- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    color: #616161;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #1976D2;
    font-size: 12px;
    background-color: transparent;
}

/* ---- ScrollArea & ScrollBars ---- */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #BDBDBD;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #1976D2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: #BDBDBD;
    min-width: 30px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #1976D2; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: #E0E0E0;
}
QSplitter::handle:hover { background-color: #1976D2; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }

/* ---- Tooltip ---- */
QToolTip {
    background-color: #FFFFFF;
    color: #212121;
    border: 1px solid #BDBDBD;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ---- StatusBar ---- */
QStatusBar {
    background-color: #ECEFF1;
    color: #616161;
    border-top: 1px solid #E0E0E0;
}

/* ---- Dialog ---- */
QDialog {
    background-color: #F5F7FA;
}
