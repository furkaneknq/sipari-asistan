/* ============================================================
   Grafit Tema
   ============================================================ */

QMainWindow, QWidget, QDialog {
    background-color: #202327;
    color: #E4E7EB;
    font-family: "Segoe UI", "Inter", "Arial";
    font-size: 13px;
}

#HeaderBar {
    background-color: #111418;
    color: #E4E7EB;
    padding: 8px 16px;
    border-bottom: 1px solid #30343A;
}
#HeaderTitle {
    color: #F4C430;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
    border: none;
}
#HeaderInfo {
    color: #D4D8DE;
    font-size: 14px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QTabWidget::pane {
    border: none;
    background: #202327;
}
QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: #2A2E34;
    color: #B8BEC8;
    padding: 8px 14px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom: 2px solid transparent;
    font-weight: 500;
    font-size: 12px;
    min-width: 60px;
}
QTabBar::tab:selected {
    background: #111418;
    color: #F4C430;
    border-bottom: 2px solid #F4C430;
}
QTabBar::tab:hover:!selected {
    background: #30343A;
    color: #E4E7EB;
}

QPushButton {
    background-color: #F4C430;
    color: #111418;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 700;
}
QPushButton:hover { background-color: #DDAF24; }
QPushButton:pressed { background-color: #BF9218; }
QPushButton:disabled { background-color: #30343A; color: #707782; }

QPushButton#SecondaryButton {
    background-color: transparent;
    color: #F4C430;
    border: 1px solid #555D68;
}
QPushButton#SecondaryButton:hover {
    background-color: #30343A;
    border-color: #F4C430;
}
QPushButton#DangerButton { background-color: #D05A50; color: #FFFFFF; }
QPushButton#DangerButton:hover { background-color: #B7463D; }
QPushButton#SuccessButton { background-color: #3EA66B; color: #FFFFFF; }
QPushButton#SuccessButton:hover { background-color: #328958; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QTextEdit, QPlainTextEdit {
    background-color: #171A1F;
    color: #E4E7EB;
    border: 1px solid #404650;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #F4C430;
    selection-color: #111418;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #555D68;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #F4C430;
}
QComboBox QAbstractItemView {
    background-color: #171A1F;
    color: #E4E7EB;
    border: 1px solid #555D68;
    selection-background-color: #30343A;
    selection-color: #F4C430;
}

QTableWidget, QTableView {
    background-color: #171A1F;
    alternate-background-color: #202327;
    color: #E4E7EB;
    border: 1px solid #30343A;
    border-radius: 6px;
    gridline-color: #30343A;
    selection-background-color: #4B3E13;
    selection-color: #FFF3B0;
}
QTableWidget::item, QTableView::item {
    padding: 4px 6px;
    border: none;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #4B3E13;
    color: #FFF3B0;
    font-weight: 500;
}
QHeaderView::section {
    background-color: #111418;
    color: #B8BEC8;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #30343A;
    border-right: 1px solid #30343A;
    font-weight: 600;
    font-size: 11px;
}
QHeaderView { background-color: #111418; }

QGroupBox {
    background-color: #252930;
    border: 1px solid #30343A;
    border-radius: 6px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    color: #B8BEC8;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #F4C430;
    background-color: transparent;
}

QFrame#OrderCard {
    background-color: #252930;
    border: 1px solid #30343A;
    border-radius: 8px;
    padding: 8px;
}
QFrame#OrderCard:hover {
    border: 1px solid #F4C430;
    background-color: #2A2E34;
}
QLabel#OrderNumber { color: #F4C430; font-size: 14px; font-weight: bold; }
QLabel#OrderAmount { color: #6ED19A; font-size: 13px; font-weight: bold; }
QLabel#OrderTime { color: #9EA5AF; font-size: 11px; }
QLabel#OrderCustomer { color: #E4E7EB; font-size: 13px; }

QFrame#KanbanColumn {
    background-color: #171A1F;
    border-radius: 8px;
    padding: 8px;
}
QLabel#KanbanTitle {
    color: #D4D8DE;
    font-size: 14px;
    font-weight: bold;
    padding: 4px 0;
}

QWidget#IncomingCallPopup {
    background-color: #252930;
    border: 2px solid #F4C430;
    border-radius: 12px;
}
QLabel#CallTitle { font-size: 14px; font-weight: bold; color: #F4C430; }
QLabel#CallNumber { font-size: 22px; font-weight: bold; color: #FFFFFF; }
QLabel#CallMatchYes { font-size: 14px; color: #6ED19A; font-weight: bold; }
QLabel#CallMatchNo { font-size: 14px; color: #FF8C80; font-weight: bold; }

QLabel.StatusPill {
    border-radius: 10px;
    padding: 2px 8px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: bold;
}
QLabel#SummaryBox, QLabel#OrderNotes {
    background-color: #171A1F;
    color: #E4E7EB;
    border: 1px solid #404650;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: bold;
}
QLabel#SettingsInfo {
    color: #B8BEC8;
    font-size: 13px;
}

QCheckBox, QRadioButton {
    color: #E4E7EB;
    spacing: 6px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #707782;
    border-radius: 3px;
    background: #171A1F;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #F4C430;
}
QCheckBox::indicator:checked {
    background-color: #F4C430;
    border-color: #F4C430;
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #555D68;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #F4C430;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
