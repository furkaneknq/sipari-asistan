# =============================================================
# Bu dosyayı .env olarak KOPYALA ve değerleri kendi
# Supabase projenden alıp doldur. .env dosyasını GİT'E EKLEME.
# =============================================================

# Supabase proje URL'si
# Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SECRET KEY (eski adı service_role)
# Settings -> API -> Secret keys -> Reveal
# UYARI: Bu anahtar RLS'i bypass eder, ASLA mobile uygulamada
# veya public bir yerde paylaşma. Sadece bu masaüstü uygulama
# içinde kullanılacak.
SUPABASE_SECRET_KEY=eyJhbGciOi...

# (Opsiyonel) Authenticated mod kullanmak istersen publishable key
# SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Yazıcı tipi: usb / network / serial / dummy
PRINTER_TYPE=dummy
PRINTER_USB_VENDOR_ID=0x04b8
PRINTER_USB_PRODUCT_ID=0x0202
PRINTER_NETWORK_HOST=192.168.1.100
PRINTER_NETWORK_PORT=9100
PRINTER_PAPER_WIDTH=80
